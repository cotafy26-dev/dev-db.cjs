# ============================================================
# HERMES IA - variaveis de ambiente (copie para .env)
# NUNCA versione o .env. NUNCA coloque chaves reais no codigo.
# ============================================================

NODE_ENV=development
PORT=3333
APP_URL=http://localhost:5173
API_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:5173

# ---- Banco de dados (PostgreSQL: Neon / Supabase / Railway / Docker) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hermes?schema=public

# ---- Filas / cache (opcional - secao 35). Vazio = scheduler in-process ----
REDIS_URL=

# ---- Cron externo (hosting sem processo sempre ativo). Ver docs/DEPLOY.md ----
# POST /api/cron/tick?kind=daily&key=CRON_SECRET
CRON_SECRET=

# ---- Autenticacao ----
# Gere: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao
# (opcionais - por padrao derivados de JWT_SECRET)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- IA (endpoint compativel com OpenAI). Padrao: Ollama local ----
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=hermes3:8b
AI_TEMPERATURE=0.2
AI_MAX_TOOL_ITERATIONS=6
AI_HISTORY_MESSAGES=14
AI_RATE_PER_MIN=20
AI_REQUEST_TIMEOUT_MS=120000

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_MODE=polling

# ---- WhatsApp (API oficial Cloud API ou provedor compativel) ----
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- Observabilidade ----
LOG_LEVEL=info
