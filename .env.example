# ============================================================
# HERMES IA - variaveis de ambiente (copie para .env)
# ============================================================

# ---- Ambiente ----
NODE_ENV=development
# Porta da API
PORT=3333
# URL publica do frontend (para CORS)
WEB_ORIGIN=http://localhost:5173

# ---- Banco de dados (PostgreSQL na nuvem: Neon / Supabase / Railway) ----
# Exemplo Neon: postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/hermes?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hermes?schema=public

# ---- Autenticacao ----
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-este-valor-em-producao
JWT_REFRESH_SECRET=troque-este-outro-valor-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- IA (endpoint compativel com OpenAI) ----
# Padrao: Ollama local. Alternativas: OpenAI, OpenRouter, Together, vLLM.
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=hermes3:8b
# Modelo mais leve para respostas rapidas em CPU (opcional):
# AI_MODEL=llama3.2:3b
AI_TEMPERATURE=0.2
AI_MAX_TOOL_ITERATIONS=6
AI_REQUEST_TIMEOUT_MS=120000

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Em dev usamos long-polling; em producao defina a URL publica do webhook:
TELEGRAM_WEBHOOK_URL=
TELEGRAM_MODE=polling

# ---- WhatsApp (Cloud API - estruturado, ativado na Fase 2) ----
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- Observabilidade ----
LOG_LEVEL=info
