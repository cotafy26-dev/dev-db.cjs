// HERMES IA - schema do banco (PostgreSQL)
// Multi-tenant: toda entidade de negocio carrega companyId.
// A IA NUNCA acessa este banco diretamente - somente via services/tools do backend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenancy & Autenticacao
// ============================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  document  String? // CNPJ / CPF
  phone     String?
  email     String?
  timezone  String   @default("America/Sao_Paulo")
  currency  String   @default("BRL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  customers           Customer[]
  products            Product[]
  stockMovements      StockMovement[]
  sales               Sale[]
  financeCategories   FinanceCategory[]
  financeTransactions FinanceTransaction[]
  receivables         Receivable[]
  payables            Payable[]
  agendaEvents        AgendaEvent[]
  conversations       Conversation[]
  channelLinks        ChannelLink[]
  pairingCodes        PairingCode[]
  aiToolCalls         AiToolCall[]
  subscription        Subscription?
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         UserRole @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  conversations Conversation[]

  @@unique([companyId, email])
  @@index([companyId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================
// CRM
// ============================================================

model Customer {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  document  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales       Sale[]
  receivables Receivable[]
  agendaEvents AgendaEvent[]

  @@index([companyId])
  @@index([companyId, name])
}

// ============================================================
// Catalogo & Estoque
// ============================================================

model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku         String?
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  stock       Decimal  @default(0) @db.Decimal(14, 3)
  minStock    Decimal  @default(0) @db.Decimal(14, 3)
  unit        String   @default("un")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, name])
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

model StockMovement {
  id           String            @id @default(cuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         StockMovementType
  quantity     Decimal           @db.Decimal(14, 3) // magnitude positiva
  balanceAfter Decimal           @db.Decimal(14, 3)
  reason       String?
  saleId       String?
  createdBy    String?
  createdAt    DateTime          @default(now())

  @@index([companyId])
  @@index([productId])
}

// ============================================================
// Vendas
// ============================================================

enum PaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
  TRANSFER
  BOLETO
  OTHER
}

enum SaleStatus {
  PAID
  PARTIAL
  PENDING
  CANCELED
}

model Sale {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  number        Int
  status        SaleStatus     @default(PAID)
  paymentMethod PaymentMethod?
  subtotal      Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)
  note          String?
  soldAt        DateTime       @default(now())
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items               SaleItem[]
  receivable          Receivable?
  financeTransactions FinanceTransaction[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, soldAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal  @db.Decimal(14, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  @@index([saleId])
}

// ============================================================
// Financeiro
// ============================================================

enum FinanceType {
  INCOME
  EXPENSE
}

model FinanceCategory {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  type      FinanceType
  createdAt DateTime    @default(now())

  transactions FinanceTransaction[]

  @@unique([companyId, name, type])
  @@index([companyId])
}

model FinanceTransaction {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          FinanceType
  amount        Decimal          @db.Decimal(12, 2)
  description   String
  categoryId    String?
  category      FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod?
  occurredAt    DateTime         @default(now())
  saleId        String?
  sale          Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  receivableId  String?
  payableId     String?
  createdBy     String?
  createdAt     DateTime         @default(now())

  @@index([companyId])
  @@index([companyId, occurredAt])
  @@index([companyId, type])
}

enum SettlementStatus {
  OPEN
  PARTIAL
  PAID
  CANCELED
}

model Receivable {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  saleId      String?          @unique
  sale        Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  description String
  amount      Decimal          @db.Decimal(12, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(12, 2)
  dueDate     DateTime?
  status      SettlementStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
}

model Payable {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierName String?
  description  String
  amount       Decimal          @db.Decimal(12, 2)
  paidAmount   Decimal          @default(0) @db.Decimal(12, 2)
  dueDate      DateTime?
  status       SettlementStatus @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
}

// ============================================================
// Agenda
// ============================================================

enum AgendaEventStatus {
  SCHEDULED
  DONE
  CANCELED
}

model AgendaEvent {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  customerId  String?
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status      AgendaEventStatus @default(SCHEDULED)
  remindAt    DateTime?
  createdBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([companyId])
  @@index([companyId, startsAt])
}

// ============================================================
// IA / Conversas / Canais
// ============================================================

enum ChannelType {
  WEB
  TELEGRAM
  WHATSAPP
}

model ChannelLink {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel      ChannelType
  externalId   String // telegram chat id / whatsapp phone
  displayName  String?
  linkedUserId String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  @@unique([channel, externalId])
  @@index([companyId])
}

model PairingCode {
  code      String      @id
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel   ChannelType
  createdBy String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([companyId])
}

model Conversation {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel       ChannelType
  externalId    String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  title         String?
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())

  messages Message[]

  @@unique([companyId, channel, externalId])
  @@index([companyId])
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  toolName       String?
  toolCallId     String?
  toolArgs       Json?
  toolResult     Json?
  tokensIn       Int?
  tokensOut      Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model AiToolCall {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId String?
  toolName       String
  args           Json
  status         String // SUCCESS | ERROR | REJECTED
  result         Json?
  error          String?
  durationMs     Int?
  createdAt      DateTime @default(now())

  @@index([companyId])
  @@index([companyId, toolName])
}

// ============================================================
// Billing (stub - implementado na Fase 2)
// ============================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id               String             @id @default(cuid())
  companyId        String             @unique
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan             String             @default("trial")
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}
